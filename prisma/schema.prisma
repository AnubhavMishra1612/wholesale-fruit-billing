// Prisma schema for Wholesale Fruit Billing Application
// Database Provider: PostgreSQL
// Multi-tenant: Every business entity is partitioned by userId (session user ID).
// Client and payment relations enforce composite foreign keys to guarantee tenant & customer isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. USER & TENANT CORE
// ============================================================
model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String
  resetToken        String?    @unique
  resetTokenExpires DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  settings           Settings?
  clients            Client[]
  invoices           Invoice[]
  expenses           Expense[]
  recurringProfiles  RecurringProfile[]
  activities         InvoiceActivity[]
  fruitUnits         FruitUnit[]
  fruits             Fruit[]
  dailyPrices        DailyFruitPrice[]
  customerPrices     CustomerFruitPrice[]
  payments           Payment[]
  paymentRefunds     PaymentRefund[]
  paymentAllocations PaymentAllocation[]
  ledgerAdjustments  LedgerAdjustment[]
  dailySequences     DailySequence[]
  auditLogs          AuditLog[]

  @@map("users")
}

// ============================================================
// 2. BUSINESS PROFILE & SETTINGS
// ============================================================
model Settings {
  id               Int      @id @default(autoincrement())
  userId           String   @unique
  companyName      String   @default("Your Business Name")
  companyEmail     String   @default("billing@example.com")
  companyAddress   String?
  companyPhone     String?
  mandiLicenseNo   String?  // Mandi / APMC trader license number
  gstin            String?  // GSTIN tax identification
  defaultTaxRate   Decimal  @default(0) @db.Decimal(5, 2)
  taxLabel         String   @default("GST")
  currency         String   @default("INR")
  logoData         String?  @db.Text
  logoContentType  String?
  brandColor       String   @default("#173D32")
  defaultNotes     String?  @db.Text
  defaultDueDays   Int      @default(30)
  invoicePrefix    String   @default("INV")
  invoiceSeparator String   @default("-")
  invoicePad       Int      @default(4)
  receiptPrefix    String   @default("RCP")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ============================================================
// 3. ATOMIC NUMBERING SEQUENCER (CONCURRENCY-SAFE)
// ============================================================
// Eliminates TOCTOU race conditions during simultaneous invoice/receipt/refund generation.
model DailySequence {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String   // Format: "YYYYMMDD" evaluated in Asia/Calcutta (IST)
  prefix    String   // "INV", "RCP", "RFD"
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, prefix], name: "daily_sequence_per_tenant")
  @@index([userId, dateKey])
  @@map("daily_sequences")
}

// ============================================================
// 4. FRUIT UNITS (UOM)
// ============================================================
model FruitUnit {
  id         String   @id @default(cuid())
  userId     String
  name       String   // "Kilogram", "Crate", "Box", "Bag", "Dozen"
  code       String   // "kg", "crt", "box", "bag", "doz"
  isDefault  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fruits         Fruit[]
  dailyPrices    DailyFruitPrice[]
  customerPrices CustomerFruitPrice[]
  invoiceItems   InvoiceItem[]
  recurringItems RecurringItem[]

  @@unique([id, userId], name: "unit_tenant_composite")
  @@unique([userId, code], name: "unit_code_per_user")
  @@index([userId, isArchived])
  @@map("fruit_units")
}

// ============================================================
// 5. FRUIT CATALOGUE
// ============================================================
model Fruit {
  id            String   @id @default(cuid())
  userId        String
  name          String   // e.g. "Apple"
  variety       String?  // e.g. "Kashmiri Delicious"
  category      String?  // e.g. "Pome"
  hsnCode       String?  @default("0808")
  defaultUnitId String?
  isActive      Boolean  @default(true)
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultUnit    FruitUnit?           @relation(fields: [defaultUnitId], references: [id], onDelete: SetNull)
  dailyPrices    DailyFruitPrice[]
  customerPrices CustomerFruitPrice[]
  invoiceItems   InvoiceItem[]
  recurringItems RecurringItem[]

  @@unique([id, userId], name: "fruit_tenant_composite")
  @@index([userId, isActive, isArchived])
  @@index([userId, name])
  @@map("fruits")
}

// ============================================================
// 6. DAILY FRUIT PRICE HISTORY
// ============================================================
model DailyFruitPrice {
  id            String   @id @default(cuid())
  userId        String
  fruitId       String
  unitId        String
  effectiveDate DateTime @db.Date // Rate date (IST morning market rate)
  price         Decimal  @db.Decimal(12, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fruit Fruit     @relation(fields: [fruitId, userId], references: [id, userId], onDelete: Restrict)
  unit  FruitUnit @relation(fields: [unitId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, fruitId, unitId, effectiveDate], name: "daily_fruit_price_per_user")
  @@index([userId, effectiveDate])
  @@index([fruitId, effectiveDate])
  @@map("daily_fruit_prices")
}

// ============================================================
// 7. CUSTOMER-SPECIFIC NEGOTIATED PRICE HISTORY
// ============================================================
model CustomerFruitPrice {
  id            String    @id @default(cuid())
  userId        String
  clientId      String
  fruitId       String
  unitId        String
  price         Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // Null = indefinite active contract
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client    @relation(fields: [clientId, userId], references: [id, userId], onDelete: Restrict)
  fruit  Fruit     @relation(fields: [fruitId, userId], references: [id, userId], onDelete: Restrict)
  unit   FruitUnit @relation(fields: [unitId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, clientId, fruitId, unitId, effectiveFrom], name: "customer_fruit_price_version")
  @@index([userId, clientId, effectiveFrom])
  @@map("customer_fruit_prices")
}

// ============================================================
// 8. CLIENT MODEL
// ============================================================
model Client {
  id             String   @id @default(cuid())
  userId         String
  name           String
  email          String
  address        String?
  phone          String?
  notes          String?  @db.Text
  dueDays        Int?
  portalToken    String   @unique @default(cuid())
  openingBalance Decimal  @default(0) @db.Decimal(12, 2) // Signed: + debtor, - creditor
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  recurringProfiles RecurringProfile[]
  customerPrices    CustomerFruitPrice[]
  payments          Payment[]
  paymentRefunds    PaymentRefund[]
  allocations       PaymentAllocation[]
  ledgerAdjustments LedgerAdjustment[]

  @@unique([id, userId], name: "client_tenant_composite")
  @@unique([userId, email], name: "client_email_per_user")
  @@index([userId, isArchived])
  @@map("clients")
}

// ============================================================
// 9. INVOICE MODEL
// ============================================================
model Invoice {
  id                      String        @id @default(cuid())
  userId                  String
  invoiceNumber           String
  clientId                String
  status                  InvoiceStatus @default(DRAFT)
  issueDate               DateTime      @db.Date
  dueDate                 DateTime      @db.Date
  subtotal                Decimal       @db.Decimal(12, 2)
  discountType            DiscountType?
  discountValue           Decimal?      @db.Decimal(12, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(12, 2)
  taxRate                 Decimal       @default(0) @db.Decimal(5, 2)
  taxLabel                String        @default("GST")
  totalAmount             Decimal       @db.Decimal(12, 2)
  paidAmount              Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount           Decimal       @default(0) @db.Decimal(12, 2)
  notes                   String?       @db.Text
  paidAt                  DateTime?
  lastSentAt              DateTime?
  lastRemindedAt          DateTime?
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  razorpayOrderId         String?
  razorpayPaymentId       String?
  razorpaySignature       String?
  recurringProfileId      String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [clientId, userId], references: [id, userId], onDelete: Restrict)
  items       InvoiceItem[]
  allocations PaymentAllocation[]
  recurring   RecurringProfile?   @relation(fields: [recurringProfileId], references: [id], onDelete: SetNull)
  activities  InvoiceActivity[]

  @@unique([userId, invoiceNumber], name: "invoice_number_per_user")
  @@unique([id, userId, clientId], name: "invoice_tenant_client_composite")
  @@unique([id, userId], name: "invoice_tenant_composite")
  @@index([userId])
  @@index([clientId])
  @@index([userId, status])
  @@map("invoices")
}

// ============================================================
// 10. INVOICE ITEM MODEL (SNAPSHOTS & DECIMAL WEIGHTS)
// ============================================================
model InvoiceItem {
  id                String   @id @default(cuid())
  invoiceId         String
  description       String
  quantity          Decimal  @default(1) @db.Decimal(10, 3) // Capacity: 0.001 to 9,999,999.999
  price             Decimal  @db.Decimal(12, 2)
  total             Decimal  @db.Decimal(12, 2)
  fruitId           String?
  fruitName         String?  // Immutable snapshot at issue time
  fruitVariety      String?  // Immutable snapshot at issue time
  unitId            String?
  unitName          String?  // Immutable snapshot at issue time (e.g. "kg")
  unitPriceSnapshot Decimal? @db.Decimal(12, 2)

  invoice Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fruit   Fruit?     @relation(fields: [fruitId], references: [id], onDelete: Restrict)
  unit    FruitUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([fruitId])
  @@map("invoice_items")
}

// ============================================================
// 11. PAYMENT MODEL (RECEIPTS & UNALLOCATED CREDITS)
// ============================================================
model Payment {
  id                String        @id @default(cuid())
  userId            String
  clientId          String
  receiptNumber     String        @unique // Format: "RCP-YYYYMMDD-0001"
  amount            Decimal       @db.Decimal(12, 2) // Gross cash/funds received
  allocatedAmount   Decimal       @default(0) @db.Decimal(12, 2) // Sum of ACTIVE allocations
  refundedAmount    Decimal       @default(0) @db.Decimal(12, 2) // Sum of COMPLETED refunds
  unallocatedAmount Decimal       @default(0) @db.Decimal(12, 2) // amount - allocatedAmount - refundedAmount
  paymentDate       DateTime      @default(now())
  paymentMethod     PaymentMethod @default(CASH)
  status            PaymentStatus @default(COMPLETED)
  referenceNumber   String?       // UTR, Cheque No, or UPI Reference
  notes             String?       @db.Text
  voidReason        String?       @db.Text
  voidedAt          DateTime?
  voidedBy          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [clientId, userId], references: [id, userId], onDelete: Restrict)
  allocations PaymentAllocation[]
  refunds     PaymentRefund[]

  @@unique([id, userId, clientId], name: "payment_tenant_client_composite")
  @@unique([id, userId], name: "payment_tenant_composite")
  @@index([userId, clientId])
  @@index([userId, paymentDate])
  @@index([userId, status])
  @@map("payments")
}

// ============================================================
// 12. PAYMENT ALLOCATION MODEL (REVERSIBLE & AUDITABLE)
// ============================================================
model PaymentAllocation {
  id             String           @id @default(cuid())
  userId         String
  clientId       String           // Enforces tenant & customer match via composite FK
  paymentId      String
  invoiceId      String
  amount         Decimal          @db.Decimal(12, 2)
  status         AllocationStatus @default(ACTIVE)
  allocatedAt    DateTime         @default(now())
  reversedAt     DateTime?
  reversalReason String?          @db.Text
  reversedBy     String?
  notes          String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId, userId], references: [id, userId], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId, userId, clientId], references: [id, userId, clientId], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId, userId, clientId], references: [id, userId, clientId], onDelete: Restrict)

  @@index([userId, invoiceId, status])
  @@index([paymentId, status])
  @@map("payment_allocations")
}

// ============================================================
// 13. PAYMENT REFUND MODEL (CASH OUTFLOW TO CLIENT)
// ============================================================
model PaymentRefund {
  id              String        @id @default(cuid())
  userId          String
  clientId        String
  paymentId       String        // Tied directly to the source payment receipt
  refundNumber    String        @unique // e.g. "RFD-YYYYMMDD-0001"
  amount          Decimal       @db.Decimal(12, 2)
  refundDate      DateTime      @default(now())
  paymentMethod   PaymentMethod @default(CASH)
  status          RefundStatus  @default(COMPLETED)
  referenceNumber String?
  reason          String        @db.Text
  voidReason      String?       @db.Text
  voidedAt        DateTime?
  voidedBy        String?
  createdAt       DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId, userId], references: [id, userId], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId, userId, clientId], references: [id, userId, clientId], onDelete: Restrict)

  @@index([userId, clientId])
  @@index([userId, refundDate])
  @@map("payment_refunds")
}

// ============================================================
// 14. LEDGER ADJUSTMENTS (DEBIT/CREDIT NOTES & WRITE-OFFS)
// ============================================================
model LedgerAdjustment {
  id            String         @id @default(cuid())
  userId        String
  clientId      String
  type          AdjustmentType // CREDIT_NOTE, DEBIT_NOTE, BAD_DEBT_WRITE_OFF
  amount        Decimal        @db.Decimal(12, 2)
  effectiveDate DateTime       @db.Date
  reason        String         @db.Text
  referenceNo   String?
  createdAt     DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, clientId, effectiveDate])
  @@map("ledger_adjustments")
}

// ============================================================
// 15. AUDIT LOG (FINANCIAL & PRICING AUDIT TRAIL)
// ============================================================
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // "DAILY_PRICE", "CUSTOMER_PRICE", "PAYMENT", "ALLOCATION", "INVOICE", "REFUND"
  entityId   String
  action     String   // "CREATED", "UPDATED", "VOIDED", "REVERSED", "BULK_UPDATED"
  actorId    String?
  ip         String?
  changes    Json?    // Serialized { before, after } state
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// 16. RECURRING PROFILES & ITEMS
// ============================================================
model RecurringProfile {
  id           String              @id @default(cuid())
  userId       String
  clientId     String
  frequency    RecurrenceFrequency
  intervalDays Int?
  dueInDays    Int                 @default(30)
  taxRate      Decimal             @default(0) @db.Decimal(5, 2)
  notes        String?             @db.Text
  autoSend     Boolean             @default(true)
  active       Boolean             @default(true)
  nextRunAt    DateTime
  endDate      DateTime?
  lastRunAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client          @relation(fields: [clientId, userId], references: [id, userId], onDelete: Restrict)
  items    RecurringItem[]
  invoices Invoice[]

  @@index([userId, active, nextRunAt])
  @@index([userId])
  @@map("recurring_profiles")
}

model RecurringItem {
  id          String   @id @default(cuid())
  profileId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 3)
  price       Decimal  @db.Decimal(12, 2)
  fruitId     String?
  unitId      String?
  unitName    String?

  profile RecurringProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fruit   Fruit?           @relation(fields: [fruitId], references: [id], onDelete: SetNull)
  unit    FruitUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@map("recurring_items")
}

// ============================================================
// 17. INVOICE ACTIVITY (EXISTING TIMELINE AUDIT)
// ============================================================
model InvoiceActivity {
  id        String              @id @default(cuid())
  invoiceId String
  userId    String
  type      InvoiceActivityType
  message   String?             @db.Text
  ip        String?
  meta      Json?
  createdAt DateTime            @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([userId])
  @@map("invoice_activities")
}

// ============================================================
// 18. EXPENSE MODEL
// ============================================================
model Expense {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  category    String   @default("General")
  description String
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
  @@map("expenses")
}

// ============================================================
// 19. ENUMS
// ============================================================
enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

enum AllocationStatus {
  ACTIVE
  REVERSED
}

enum RefundStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum AdjustmentType {
  CREDIT_NOTE
  DEBIT_NOTE
  BAD_DEBT_WRITE_OFF
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM_DAYS
}

enum InvoiceActivityType {
  CREATED
  EDITED
  SENT
  REMINDED
  VIEWED
  PAID
  PAYMENT_FAILED
  MARKED_PAID
  PDF_DOWNLOADED
  DELETED
  RECURRING_GENERATED
  VOIDED
  EMAIL_DELIVERED
  EMAIL_BOUNCED
  EMAIL_OPENED
}

enum DiscountType {
  PERCENT
  FIXED
}
