# ============================================================
# SmartBilling / Wholesale Fruit Billing Environment Config
# ============================================================
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit real credentials, production secrets, or private keys.

# ------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartbilling?schema=public"

# ------------------------------------------------------------
# 2. Authentication (NextAuth v5 / Auth.js)
# ------------------------------------------------------------
# Generate a secure 32+ byte hex string using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-hex-secret"

# Public site URL (used in email links, invoice links, webhooks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Default credentials for initial database seeding
ADMIN_EMAIL="admin@smartbill.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# ------------------------------------------------------------
# 3. Email Delivery (Resend) - Optional
# ------------------------------------------------------------
# Required only if sending invoice emails, portal invites, or payment receipts
RESEND_API_KEY="re_placeholder_api_key"
FROM_EMAIL="Wholesale Fruit Billing <billing@example.com>"
RESEND_WEBHOOK_SECRET="whsec_placeholder_secret"

# ------------------------------------------------------------
# 4. Background Jobs & Cron - Optional
# ------------------------------------------------------------
# Secret used to authorize cron API endpoints (e.g., /api/cron/send-reminders)
CRON_SECRET="replace-with-secure-cron-secret"

# ------------------------------------------------------------
# 5. AI Receipt Scanning (OpenAI) - Optional
# ------------------------------------------------------------
# Required only for expense / receipt parsing with GPT-4o-mini
OPENAI_API_KEY="sk-placeholder-openai-key"

# ------------------------------------------------------------
# 6. Payment Gateways - Optional
# ------------------------------------------------------------
# Stripe (Card / International payments)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Razorpay (UPI, Netbanking, Cards for INR payments)
RAZORPAY_KEY_ID="rzp_test_placeholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"
